# Tactical AI / RAG
RAG_SERVICE_URL=http://localhost:8003
OPENROUTER_API_KEY=sk-or-v1-...
RL_MODEL_PATH=training/models/final.json

# Prometheus label
NODE_APP_INSTANCE=default
METRICS_USERNAME=admin
METRICS_PASSWORD=password

# RL Bot Configuration
# BOT_MODE options: rule_based | rl | hybrid
BOT_MODE=hybrid
RL_MODEL_PATH=./modules/@creature-chess/rl-bot/training/models/final

# Training Configuration
# When false, bot plays with loaded model but does NOT store experiences,
# update policy, or auto-save checkpoints. Useful for inference-only mode.
TRAINING_MODE=false
TRAINING_EPISODES=20
PARALLEL_GAMES=1000
SAVE_INTERVAL=5

# Bot Difficulty (same model, different sampling)
# Higher = easier/bot plays more randomly (e.g. 2.0)
# Lower  = harder/bot plays more greedily (e.g. 0.5)
# 1.0 = default balanced
RL_TEMPERATURE=1.0

# Performance
INFERENCE_TIMEOUT_MS=50
MODEL_QUANTIZATION=true
